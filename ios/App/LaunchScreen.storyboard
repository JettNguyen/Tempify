    <scenes>
        <scene sceneID="scene-launch">
            <objects>
                <viewController id="vc-launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-root">
                        <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="image-logo">
